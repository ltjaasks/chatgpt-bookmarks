{
  "manifest_version": 3,
  "name": "ChatGPT Bookmarks",
  "version": "1.0",
  "description": "Bookmark ChatGPT responses",
  "permissions": ["storage"],
  "host_permissions": [
    "https://chat.openai.com/*",
    "https://chatgpt.com/*"
    ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*"
        ],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ]
}