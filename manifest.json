{
  "manifest_version": 3,
  "name": "Bookmarks for ChatGPT",
  "version": "1.0",
  "description": 
  "Bookmark ChatGPT responses to easily return to them.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://chat.openai.com/*",
    "https://chatgpt.com/*"
    ],
  "action": {
    "default_icon": {
      "16": "icons/icons16.png",
      "48": "icons/icons48.png",
      "128": "icons/icons128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*"
        ],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "icons": {
  "16": "icons/icons16.png",
  "48": "icons/icons48.png",
  "128": "icons/icons128.png"
  }
}